# Backend environment variables — copy to .env and fill in real values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
# Your Aiven PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-64-char-random-secret-here

# ── CORS ────────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production
# Example: https://frames-xxxx.vercel.app  OR your custom domain
FRONTEND_URL=http://localhost:3000

# ── Kiosk device authentication ────────────────────────────────────────────────
# Shared secret for Raspberry Pi kiosks
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
KIOSK_API_KEY=your-kiosk-api-key-here

# ── Logging ─────────────────────────────────────────────────────────────────────
# DEBUG in local dev, INFO in production
# ── Email (SMTP - Password resets) ──────────────────────────────────────────
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── SendGrid (Approvals & Support Tickets) ──────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_SENDER=framessys01@gmail.com
