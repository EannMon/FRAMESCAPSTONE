# ============================================================
# FRAMES RPi Kiosk — Environment Variables (USB Webcam Setup)
# Copy this to .env inside the backend/rpi/ directory.
# DO NOT commit actual values to git.
# ============================================================

# ── Platform ─────────────────────────────────────────────────
# Forces RPi mode (smaller det_size, gated detection, 640×480).
# Auto-detected via platform.machine() on ARM, but explicit is safer.
FRAMES_PLATFORM=rpi

# ── Camera ───────────────────────────────────────────────────
# Set to 0 to skip picamera2 and use OpenCV directly with the USB webcam.
# The ICON USB 720p webcam is UVC-compliant — OpenCV detects it as /dev/video0.
# If /dev/video0 is taken by something else, try CAMERA_INDEX=1.
USE_PICAMERA2=0
CAMERA_INDEX=0

# ── Backend API ──────────────────────────────────────────────
# The main FRAMES FastAPI backend (Aiven/cloud).
# kiosk_server.py calls this to resolve schedules and log attendance.
BACKEND_URL=http://your-backend-host:5000

# ── Device Identity ──────────────────────────────────────────
# The device_id in the FRAMES database for this kiosk.
# Ask admin which ID was assigned to this RPi unit.
DEVICE_ID=1
DEVICE_ROOM=MH-301

# ── Kiosk Server ─────────────────────────────────────────────
# kiosk_server.py runs on this port. Chromium connects here.
# Change if 8000 is occupied.
# KIOSK_PORT=8000   (no env var needed — port is hardcoded in kiosk_server.py)

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
