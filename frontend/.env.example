# Frontend environment variables — copy to .env.local and fill in real values
# NEVER commit .env.local to git

# ── API Base URL ────────────────────────────────────────────────────────────────
# Leave EMPTY for local dev (Vite proxy handles /api → localhost:5000)
# Set to your Render backend URL for production
# Example: https://frames-backend.onrender.com
VITE_API_BASE_URL=https://frames-backend.onrender.com
